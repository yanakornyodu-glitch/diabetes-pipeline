# Copy to .env and edit (never commit .env)
#   Windows: copy .env.example .env

# PostgreSQL (Docker). Change POSTGRES_PORT to 5433 if 5432 is already in use.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=diabetes

# Source CSV inside data/ (downloaded manually from Kaggle)
CSV_FILE=diabetes_dataset_with_notes.csv

# Google Sheets
GOOGLE_CREDENTIALS_FILE=credentials.json
# The long part of the sheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
SPREADSHEET_ID=
